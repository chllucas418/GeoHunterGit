/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "geohuntgit",
	"compatibility_date": "2025-04-04",
	"main": "./workers/app.ts",
	"routes": [
		{
			"pattern": "edu.hkgeohunter.com",
			"zone_name": "hkgeohunter.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
		"GOOGLE_MAPS_API_KEY": "AIzaSyCfON_uNUnUCn5EodiAuMaJPM2Ew8vvEuI",
		"GOOGLE_DRIVE_API_KEY": "AIzaSyCP2SVs_s3JuWAzpcciAHLG3X8LVT9Oio4",
		"GOOGLE_DRIVE_CLIENT_ID": "52030790032-9mmh9ru8mphtee6k514hbbe85q59nt00.apps.googleusercontent.com",
		"DEVELOPER_PASSWORD": "Chllucas2010418@4@18&3&16",
		"DEVELOPER_REGISTRATION_KEY": "GEOHUNTER_DEV_2026",
		"GEMINI_BASE_URL": "https://gateway.ai.cloudflare.com/v1/c83bdd5223424a2d1658b0c2d191c550/geohunter-proxy/google-ai-studio"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "geohunter-db",
			"database_id": "ee235934-df1c-49d2-a16c-38fc5fed440e"
		}
	],
	"r2_buckets": [
		{
			"binding": "ASSETS_BUCKET",
			"bucket_name": "geohunter-assets"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "GEOHUNTER_ROOM_DO",
				"class_name": "GeoHunterRoomDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GeoHunterRoomDO"
			]
		}
	],
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	]
}